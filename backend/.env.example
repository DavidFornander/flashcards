# Data Provider Selection
# Options: 'firestore' (default) or 'postgres'
DATA_PROVIDER=firestore

# Server Port (optional, defaults to 3001)
PORT=3001

# ============================================
# Firestore Configuration (required if DATA_PROVIDER=firestore)
# ============================================
# Option 1: JSON file path (RECOMMENDED - simplest setup)
# Download your service account JSON from Google Cloud Console and set:
GOOGLE_APPLICATION_CREDENTIALS=./path/to/service-account-key.json

# Option 2: Inline credentials (alternative method)
# If not using GOOGLE_APPLICATION_CREDENTIALS, provide these instead:
# FIRESTORE_PROJECT_ID=your-project-id
# FIRESTORE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# FIRESTORE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ============================================
# Postgres Configuration (only if DATA_PROVIDER=postgres)
# ============================================
# DATABASE_URL=postgresql://user:password@localhost:5432/flashcards
